[Unit]
Description=HoskSaid daily ingest + enrich + embeddings pipeline
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hosksaid
# Use compose's `scheduler` profile so it doesn't get pulled into `up`.
# --rm removes the container when done. The image is already built; we
# don't pass --build to avoid blocking the timer on rebuild errors.
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --profile scheduler run --rm scheduler

# Logs land in journalctl -u hosksaid-ingest.
StandardOutput=journal
StandardError=journal

# Don't let the pipeline run forever if YouTube/OpenAI hang.
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
