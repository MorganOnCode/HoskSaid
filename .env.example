# HoskSaid — production environment.
# Copy to .env (gitignored), fill in real values, never commit.

# --- Database -----------------------------------------------------------
# Used by docker-compose to create the Postgres role on first boot. The web
# + scheduler containers build their own internal URL (@postgres:5432) from
# these; they ignore DATABASE_URL below.
POSTGRES_DB=hosksaid
POSTGRES_USER=hosksaid
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24

# Read by the scripts (ingest/enrich/generate-embeddings) when run from a
# shell — on the VPS that's localhost:5432 (loopback bind); from a laptop
# it's the same after `ssh -L 5432:127.0.0.1:5432 <vps>`. Not used by the
# containers themselves.
DATABASE_URL=postgres://hosksaid:change-me-with-openssl-rand-hex-24@localhost:5432/hosksaid

# --- Secrets ------------------------------------------------------------
# Required for the cron/ingest API route to refuse anonymous calls.
# Generate: openssl rand -hex 24
CRON_SECRET=change-me

# --- External APIs ------------------------------------------------------
OPENAI_API_KEY=sk-...
YOUTUBE_API_KEY=AIza...

# --- App config ---------------------------------------------------------
# Charles Hoskinson's channel ID (default in the cron route).
DEFAULT_CHANNEL_ID=UCiJiqEvUZxT6isIaXK7RXTg

# Optional comma-separated issued API keys. Empty disables the keyed tier;
# unknown/empty bearer keys return 401. Requests without a key remain anonymous.
HOSK_API_KEYS=
# Only enable when all public traffic arrives through Cloudflare and the origin
# cannot be reached directly. Compose sets this for its loopback-only deployment.
# Otherwise clients share one anonymous bucket; X-Forwarded-For is never trusted.
TRUST_CLOUDFLARE_IP=false

# --- Paid-call bounds (site's OPENAI_API_KEY) -----------------------------
# Daily caps on site-funded model calls, per UTC day. Unset => defaults below;
# 0 disables. These bound call COUNTS, not money: also set a budget alert and
# hard limit on the OpenAI project.
SITE_DAILY_ANSWER_CAP=200
SITE_DAILY_EMBEDDING_CAP=2000
# Per-client daily allowances (client = API key, else trusted IP, else one
# shared anonymous client). Defaults are conservative development values.
CLIENT_DAILY_ANSWER_CAP=20
CLIENT_DAILY_EMBEDDING_CAP=200
# HMAC key for the stored per-client identifiers (no raw IP or key is stored).
# Unset => random per process, so allowances reset on restart.
CLIENT_QUOTA_SECRET=
# Concurrent site-funded calls per process (excess waits up to 15 s, then 503).
SITE_MAX_CONCURRENT_CALLS=4
# Store site-model questions + answers in the `answers` table (see /privacy).
PERSIST_ASK_QUESTIONS=true

# --- Edge/security --------------------------------------------------------
# 308 http->https and www->apex. Only behind the Cloudflare tunnel.
CANONICAL_REDIRECTS=false
# Extra hostnames to redirect to PUBLIC_BASE_URL (comma-separated).
CANONICAL_ALIAS_HOSTS=
# Send CSP as Content-Security-Policy-Report-Only (rollout aid).
CSP_REPORT_ONLY=false
PUBLIC_BASE_URL=https://thehosksaid.com
# Footer/privacy contact address (defaults to the current takedown address).
CONTACT_EMAIL=
# Seconds to cache public browse data in-process (default 120; stats 600).
# PUBLIC_DATA_CACHE_SECONDS=

# --- Monthly blog drafts --------------------------------------------------
# Calendar zone for months and the schedule (IANA). UTC is the development
# default until the production zone is confirmed.
MONTHLY_DRAFT_TIMEZONE=UTC
MONTHLY_DRAFT_MODEL=gpt-4o-mini
# REQUIRED to generate: model calls allowed per month across all runs. No
# default and no unlimited; a run whose plan exceeds what remains is refused
# before any call. Leave empty until a budget is approved.
MONTHLY_DRAFT_CALL_BUDGET=
# Scheduler (compose profile `monthly-drafts`): off unless true.
MONTHLY_DRAFTS_SCHEDULE_ENABLED=false
MONTHLY_SCHEDULE_DAY=1
MONTHLY_SCHEDULE_HOUR=6
MONTHLY_SCHEDULE_CATCHUP_MONTHS=2
MONTHLY_SCHEDULE_RECHECK_HOURS=24
MONTHLY_SCHEDULE_CHECK_MINUTES=60
