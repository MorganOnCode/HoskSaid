# HoskSaid — production environment.
# Copy to .env (gitignored), fill in real values, never commit.

# --- Database -----------------------------------------------------------
# Used by docker-compose to create the Postgres role on first boot. The web
# + scheduler containers build their own internal URL (@postgres:5432) from
# these; they ignore DATABASE_URL below.
POSTGRES_DB=hosksaid
POSTGRES_USER=hosksaid
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24

# Read by the scripts (ingest/enrich/generate-embeddings) when run from a
# shell — on the VPS that's localhost:5432 (loopback bind); from a laptop
# it's the same after `ssh -L 5432:127.0.0.1:5432 <vps>`. Not used by the
# containers themselves.
DATABASE_URL=postgres://hosksaid:change-me-with-openssl-rand-hex-24@localhost:5432/hosksaid

# --- Secrets ------------------------------------------------------------
# Required for the cron/ingest API route to refuse anonymous calls.
# Generate: openssl rand -hex 24
CRON_SECRET=change-me

# --- External APIs ------------------------------------------------------
OPENAI_API_KEY=sk-...
YOUTUBE_API_KEY=AIza...

# --- App config ---------------------------------------------------------
# Charles Hoskinson's channel ID (default in the cron route).
DEFAULT_CHANNEL_ID=UCiJiqEvUZxT6isIaXK7RXTg
