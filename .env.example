# HoskSaid — production environment.
# Copy to .env (gitignored), fill in real values, never commit.

# --- Database -----------------------------------------------------------
# Used by docker-compose to create the Postgres role on first boot and by
# the app + scheduler to connect via the internal `postgres` hostname.
POSTGRES_DB=hosksaid
POSTGRES_USER=hosksaid
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24

# --- Secrets ------------------------------------------------------------
# Required for the cron/ingest API route to refuse anonymous calls.
# Generate: openssl rand -hex 24
CRON_SECRET=change-me

# --- External APIs ------------------------------------------------------
OPENAI_API_KEY=sk-...
YOUTUBE_API_KEY=AIza...

# --- App config ---------------------------------------------------------
# Charles Hoskinson's channel ID (default in the cron route).
DEFAULT_CHANNEL_ID=UCiJiqEvUZxT6isIaXK7RXTg
